# Copy this file to server/.env  (NOT .env.example) and restart the API.
PORT=5000
# Local-only by default. Public deployment still requires HTTPS, firewall rules, and hardening.
HOST=127.0.0.1
CLIENT_URL=http://localhost:5173

# ---- Gmail (works out of the box) ----
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character code below (spaces are fine). Your normal password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
SMTP_FROM_NAME=Gmail Mailer
# Gmail always sends from SMTP_USER; leave blank unless you want a Reply-To address.
SMTP_FROM_EMAIL=

# Optional: multiple explicitly selected sender profiles (JSON array).
# Uncomment and replace with REAL credentials. Do not commit server/.env.
# Each profile is selected manually per campaign; accounts are not rotated to bypass quotas.
# SMTP_SENDERS_JSON=[{"id":"gmail-work","name":"Work Gmail","host":"smtp.gmail.com","port":587,"user":"work@example.com","pass":"replace-with-app-password"},{"id":"company-mail","name":"Company Mail","host":"smtp.example.com","port":587,"user":"mailer@example.com","pass":"replace-with-smtp-password"}]

# ---- Optional AI writing assistant ----
# AI is used only to draft email copy; it never sends messages. Keep the key server-side.
# Get an API key from your AI provider and never add it to client/.env or frontend code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional compatible endpoint override (leave blank for OpenAI's default API).
OPENAI_API_URL=

# ---- Multi-admin security (required) ----
# MongoDB database used for admin accounts and authentication.
MONGODB_URI=mongodb://127.0.0.1:27017/gmail_mailer
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# First-run owner setup happens inside the app. No default password is created.
NODE_ENV=development

# ---- Durable email queue (required) ----
REDIS_URL=redis://127.0.0.1:6379
EMAIL_WORKER_CONCURRENCY=1
# One-time first Owner setup token. Generate a separate random value (32+ chars).
OWNER_SETUP_TOKEN=replace-with-a-separate-random-one-time-setup-token

# Public HTTPS API origin used in RFC 8058 one-click unsubscribe URLs
PUBLIC_API_URL=https://api.yourdomain.com
MIN_SEND_DELAY_MS=1200
MAX_SEND_DELAY_MS=60000
QUEUE_MAX_PER_SECOND=1

# Signed provider webhook secret (must match server/.env).
PROVIDER_WEBHOOK_SECRET=replace-with-a-random-webhook-secret-at-least-32-characters-long

# ---- Professional provider API (Brevo native transactional API) ----
# Choose smtp (Gmail/SMTP) or brevo. Never use account rotation to evade provider quotas.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
BREVO_FROM_EMAIL=
# Set this random 32+ character token in Brevo's webhook custom header configuration.
BREVO_WEBHOOK_TOKEN=

# Recipient-level queue fan-out. Start low; increase only within your provider's approved rate.
EMAIL_WORKER_CONCURRENCY=1
QUEUE_MAX_PER_SECOND=1

# ---- Amazon SES v2 native API (optional) ----
EMAIL_PROVIDER=smtp
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SES_FROM_EMAIL=
SES_CONFIGURATION_SET=
